# Data, caches, models, and results are large and are regenerated by the pipeline.
__pycache__/
*.pyc

# Base models / extracted MTP heads
models/

# Precomputed hidden-state caches (can be hundreds of GB)
*.pt
*.pt.hidden
*.pt.raw
*.pt.full_k
*.pt.full_v
*.pt.slid_k
*.pt.slid_v

# Built datasets (regenerated by each build_classifier_dataset.py)
verih/data/
nemotron_safety/*.jsonl
cot_inconsistency/data/
agentlab/classifier_dataset.jsonl
bfcl_v4/classifier_dataset.jsonl
livecodebench/classifier_dataset.jsonl
livecodebench/gen_prompts.jsonl

# Downloaded raw benchmark data: HF livecodebench/code_generation_lite shards.
# Re-downloaded by livecodebench/build_classifier_dataset.py (~4.3 GB total).
livecodebench/data/

# Training / eval outputs
results*/
logs/
*.log

# Pipeline runtime markers (must not be versioned: a fresh checkout must not
# think generation/labelling already finished)
cot_local/.gen_done
cot_local/.labels_done
