# Data, caches, models, and results are large and are regenerated by the pipeline.
__pycache__/
*.pyc

# Base models / extracted MTP heads
models/

# Precomputed hidden-state caches (can be hundreds of GB)
*.pt
*.pt.hidden
*.pt.raw
*.pt.full_k
*.pt.full_v
*.pt.slid_k
*.pt.slid_v

# Built datasets
verih/data/
nemotron_safety/*.jsonl
cot_inconsistency/data/

# Training / eval outputs
results*/
logs/
*.log
